{
    "entity": "payment",
    "ai": {
        "enabled": true,
        "max_rows": 20
    },
    "validation": {
        "required_file_name_pattern": "payment*.ods",
        "required_sheet_name": "port_payment"
    },
    "file_path": "uploads/vinsmera/payment_adv.ods",
    "migrations": [{
        "destination_table": "payment",
        "primary_key": "id_payment",
        "mappings": {
            "id_scheme_account": {
                "lookup": {
                    "table": "scheme_account",
                    "source_column": "client_id",
                    "match_column": "ref_no",
                    "return_column": "id_scheme_account",
                    "create_if_missing": false
                },
                "validations": { "type": "numeric", "min": 1, "required": true }
            },
            "id_branch": {
                "lookup": {
                    "table": "branch",
                    "source_column": "id_branch",
                    "match_column": "id_branch",
                    "return_column": "id_branch",
                    "check_if_have": true,
                    "create_if_missing": false
                },
                "validations": { "type": "numeric", "min": 1, "required": true }
            },
            "date_payment": {
                "source_column": "date_payment",
                "validations": { "type": "date", "format": "Y-m-d", "required": true }
            },
            "payment_amount": {
                "source_column": "payment_amount",
                "validations": { "type": "numeric", "max_length": 100, "required": true }
            },
            "metal_weight": {
                "source_column": "metal_weight",
                "validations": { "type": "numeric", "max_length": 100, "required": true }
            },
            "metal_rate": {
                "source_column": "metal_rate",
                "validations": { "type": "numeric", "max_length": 100, "required": true }
            },
            "payment_mode": {
                "source_column": "payment_mode",
                "validations": { "type": "string", "max_length": 100, "required": true }
            },
            "id_scheme": {
                "lookup": {
                    "table": "scheme",
                    "source_column": "sync_scheme_code",
                    "match_column": "sync_scheme_code",
                    "return_column": "id_scheme",
                    "create_if_missing": false
                },
                "validations": { "type": "numeric", "min": 1, "required": true }
            },
            "receipt_year": {
                "source_column": "receipt_year",
                "validations": { "type": "numeric", "length": 4, "required": true }
            },
            "receipt_no": {
                "source_column": "receipt_no",
                "format": {
                    "receipt_year": "receipt_year",
                    "id_scheme": "id_scheme",
                    "receipt_no": "receipt_no"
                },
                "validations": { "type": "numeric", "min": 1, "required": true }
            },
            "added_by": {
                "source_column": "added_by",
                "validations": { "type": "numeric", "min": 1, "required": true }
            },
            "payment_status": {
                "source_column": "payment_status",
                "validations": { "type": "numeric", "min": 1, "required": false }
            },
            "payment_type": {
                "source_column": "payment_type",
                "validations": { "type": "string", "max_length": 100, "required": true }
            },
            "id_employee": {
                "lookup": {
                    "table": "employee",
                    "source_column": "referal_code",
                    "match_column": "emp_code",
                    "return_column": "id_employee",
                    "create_if_missing": false
                },
                "validations": { "type": "string", "max_length": 100, "required": false }
            }
        },
        "children": [{
            "destination_table": "payment_mode_details",
            "foreign_key": "id_payment",
            "mappings": {
                "payment_date": {
                    "source_column": "date_payment",
                    "validations": { "type": "date", "format": "Y-m-d", "required": true }
                },
                "payment_mode": {
                    "source_column": "payment_mode",
                    "validations": { "type": "string", "max_length": 255, "required": false }
                },
                "payment_amount": {
                    "source_column": "payment_amount",
                    "validations": { "type": "numeric", "min": 1, "required": true }
                },
                "payment_status": {
                    "source_column": "payment_status",
                    "validations": { "type": "numeric", "min": 1, "required": false }
                },
                "is_active": {
                    "source_column": "is_active",
                    "validations": { "type": "numeric", "min": 1, "required": false }
                }
            }
        }]
    }],
    "report": [{
        "aggregation":  "count",
        "field":        "id_payment",
        "group_by":     ["payment.id_branch"],
        "select":       "IFNULL(branch.name, '-') as branch,count(payment.id_payment) as count,max(payment.id_payment) as last_id",
        "primary_key":  "id_payment",
        "where":        {
            "current_import": {
                "added_by": 6
            }
        },
        "left_join": {
            "table": "branch",
            "on": "branch.id_branch = payment.id_branch"
        }
    },
    {
        "aggregation":  "count",
        "field":        "id_payment",
        "group_by":     ["added_by"],
        "select":       "count(id_payment) as count,max(id_payment) as last_id,if(added_by = 0,'Webapp',(if(added_by = 1,'Admin',(if(added_by = 2,'Customer App',(if(added_by = 3,'Collection App',(if(added_by = 4,'Retail App',(if(added_by = 5,'Sync',(if(added_by = 6,'Import',if(added_by = 7,'Retail Admin','-')))))))))))))) as source",
        "primary_key":  "id_payment",
        "where":        {
            "current_import": {
                "added_by": 6
            }
        }
    }
    ]
}