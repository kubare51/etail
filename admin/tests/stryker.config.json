{
  "$schema": "node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "../assets/js/**/*.js",
    "!**/*.test.js",
    "!**/node_modules/**"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "htmlReporter": {
    "fileName": "mutation-report.html"
  }
}
