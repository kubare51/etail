{
  "name": "etail-estimation-tests",
  "version": "1.0.0",
  "description": "Unit tests for ETail v3",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:watchAll": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "test:coverage-report": "jest --coverage --coverageReporters=lcov --coverageReporters=text",
    "test:mutation": "stryker run",
    "lint": "eslint ../assets/js/**/*.js --fix",
    "lint:check": "eslint ../assets/js/**/*.js"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@stryker-mutator/core": "^8.2.0",
    "@stryker-mutator/jest-runner": "^8.2.0",
    "eslint": "^8.57.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/*.test.js"
    ],
    "verbose": true,
    "collectCoverageFrom": [
      "../assets/js/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
