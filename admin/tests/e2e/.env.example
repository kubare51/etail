# ETail E2E Test Configuration
# Copy this file to .env and fill in the values

# Base URL for the application (no trailing slash)
BASE_URL=http://localhost/etail_v6/admin/index.php

# Login credentials
TEST_USERNAME=Developer
TEST_PASSWORD="Coswan@dev#etail"

# Default branch for login (leave empty for "All")
LOGIN_BRANCH=

# Test Data — Bill IDs for payment edit tests
# B2C bill (billing_for=1, no IRN)
TEST_B2C_BILL_ID=3319

# B2B bill (billing_for=2, no IRN)
TEST_B2B_BILL_ID=3064

# B2B bill with IRN (for E-Invoice guard test)
# Leave empty if no IRN bills exist in dev DB — test will be skipped
TEST_B2B_IRN_BILL_ID=
