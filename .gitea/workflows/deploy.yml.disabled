
name: ⚡ Fast Auto-Deploy

on:
  push:
    branches: [Retail_1.1.1.0001, main]
  workflow_dispatch:

jobs:
  deploy:
    runs-on: host
    timeout-minutes: 10

    steps:

    # ---------------------------------------------------------
    # STEP 1 — CHECKOUT FULL HISTORY
    # ---------------------------------------------------------
    - name: 📥 Checkout code
      uses: actions/checkout@v3
      with:
        fetch-depth: 0

    # ---------------------------------------------------------
    # STEP 2 — FETCH REMOTE REFS
    # ---------------------------------------------------------
    - name: 🔄 Fetch remote refs
      run: git fetch --all

    # ---------------------------------------------------------
    # STEP 3 — COLLECT COMMIT INFO
    # ---------------------------------------------------------
    - name: 🔎 Collect Commit Info
      id: info
      run: |
        echo "branch=${{ gitea.ref_name }}" >> $GITHUB_OUTPUT
        echo "commit_sha=${{ gitea.sha }}" >> $GITHUB_OUTPUT
        echo "before_sha=${{ gitea.before_sha }}" >> $GITHUB_OUTPUT

        echo "commit_message=$(git log -1 --pretty=%B | tr '\n' ' ')" >> $GITHUB_OUTPUT
        echo "commit_author=$(git log -1 --pretty=%an)" >> $GITHUB_OUTPUT
        echo "commit_email=$(git log -1 --pretty=%ae)" >> $GITHUB_OUTPUT
        echo "current_time=$(TZ='Asia/Kolkata' date '+%d-%m-%Y %I:%M:%S %p IST')" >> $GITHUB_OUTPUT

