    #     echo "✅ No PHP lint errors"



    # ---------------------------------------------------------
    # STEP 5 — SSH SETUP
    # ---------------------------------------------------------
    - name: 🔐 SSH Setup
      run: |
        mkdir -p ~/.ssh
        echo "${{ secrets.SSH_PRIVATE_KEY }}" > ~/.ssh/id_rsa_gitea
        chmod 600 ~/.ssh/id_rsa_gitea
        ssh-keyscan -H ${{ secrets.CPANEL_HOST }} >> ~/.ssh/known_hosts 2>/dev/null



    # ---------------------------------------------------------
    # STEP 6 — DEPLOY THROUGH SSH
    # ---------------------------------------------------------
    - name: 🚀 Execute Deployment
      id: deploy-step
      run: |
        echo "Starting deployment..."
        
        SSH_USER="${{ secrets.CPANEL_USER }}"
        SSH_HOST="${{ secrets.CPANEL_HOST }}"
        
        # Remove any whitespace from host
        SSH_HOST=$(echo "$SSH_HOST" | tr -d '[:space:]')
        
        echo "SSH Host: $SSH_HOST"
        echo "SSH User: $SSH_USER"
        echo "Branch: ${{ steps.info.outputs.branch }}"
        
        # Clean SSH command without nested bash -lc
        SSH_COMMAND="cd /home/retaillogimaxind/public_html/livetest_etail_v3 && ./deploy.sh '${{ steps.info.outputs.branch }}'"
        
        echo "Executing: $SSH_COMMAND"
        
        # Test connection first
        echo "Testing SSH connection..."
        ssh -o ConnectTimeout=10 -o BatchMode=yes -o StrictHostKeyChecking=no -i ~/.ssh/id_rsa_gitea $SSH_USER@$SSH_HOST "echo 'SSH connection successful'"
        
        # Execute deployment with detailed logging
        echo "Starting deployment command..."
        {
          OUTPUT=$(ssh \
            -o ConnectTimeout=30 \
            -o LogLevel=VERBOSE \
            -o StrictHostKeyChecking=no \
            -i ~/.ssh/id_rsa_gitea \
            $SSH_USER@$SSH_HOST \
            "$SSH_COMMAND" 2>&1)
          
          EXIT_CODE=$?
          
          echo "Exit Code: $EXIT_CODE"
          echo "Output:"
          echo "$OUTPUT"
        } | tee /tmp/deploy.log
        
        # Capture output for later use
        DEPLOY_OUTPUT=$(cat /tmp/deploy.log)
        
        echo "exit_code=$EXIT_CODE" >> $GITHUB_OUTPUT
        
        {
          echo "deploy_output<<EOF"
          echo "$DEPLOY_OUTPUT"
          echo "EOF"
        } >> $GITHUB_OUTPUT
        
        if [[ $EXIT_CODE -eq 0 ]]; then
          echo "status=success" >> $GITHUB_OUTPUT
          echo "error_type=none" >> $GITHUB_OUTPUT
        else
          echo "status=failed" >> $GITHUB_OUTPUT
          ERR_MSG=$(echo "$OUTPUT" | tail -50 | tr '\n' ' ')
          echo "error_message=$ERR_MSG" >> $GITHUB_OUTPUT
          echo "error_type=deployment_error" >> $GITHUB_OUTPUT
          exit 1
        fi

    # ---------------------------------------------------------
    # STEP 7 — EMAIL REPORT
    # ---------------------------------------------------------
    - name: 📧 Send Email Report
      if: always()
      uses: dawidd6/action-send-mail@v3
      with:
        server_address: smtp.gmail.com
        server_port: 587
        username: ${{ secrets.SMTP_USERNAME }}
        password: ${{ secrets.SMTP_PASSWORD }}
        from: "Deploy Bot <${{ secrets.SMTP_USERNAME }}>"
        to: "${{ steps.info.outputs.commit_email }}, ${{ secrets.MAIL_TO }}"
        subject: "Deployment ${{ steps.deploy-step.outputs.status }} — ${{ steps.info.outputs.branch }}"
        body: |
          DEPLOYMENT REPORT
          =================

          Status: ${{ job.status }}
          Branch: ${{ steps.info.outputs.branch }}
          Commit: ${{ steps.info.outputs.commit_sha }}
          Author: ${{ steps.info.outputs.commit_author }}
          Email:  ${{ steps.info.outputs.commit_email }}
          Time:   ${{ steps.info.outputs.current_time }}

          Commit Message:
          ${{ steps.info.outputs.commit_message }}

          -------------------------------------------------------
          PHP LINT ERRORS (if any)
          -------------------------------------------------------
          ${{ steps.lint.outputs.lint_output }}

          -------------------------------------------------------
          LAST 20 LINES OF DEPLOY OUTPUT
          -------------------------------------------------------
          ${{ steps.deploy-step.outputs.deploy_output }}
