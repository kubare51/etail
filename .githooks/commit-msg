#!/bin/sh
# ──────────────────────────────────────────────────────────────
# commit-msg hook — Auto-enriches commit messages via LCA
# 
# How it works:
#   1. If message is already structured (type(module): ...), skip
#   2. If .changes/current.json exists, use changeset data
#   3. Otherwise, auto-detect module from staged files
#
# Controlled by .githooks/config → COMMIT_MSG=on|off
# ──────────────────────────────────────────────────────────────

# ── Config check ──────────────────────────────
HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_FILE="$HOOKS_DIR/config"

if [ -f "$CONFIG_FILE" ]; then
    ENABLED=$(grep -E '^COMMIT_MSG=' "$CONFIG_FILE" | cut -d= -f2 | tr -d ' \r')
    if [ "$ENABLED" != "on" ]; then
        exit 0
    fi
fi

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge commits (auto-generated by git)
if echo "$COMMIT_MSG" | grep -qE "^Merge (branch|pull request|remote)"; then
    exit 0
fi

# Skip revert commits
if echo "$COMMIT_MSG" | grep -qE "^Revert "; then
    exit 0
fi

# Skip if already structured (type(module): ...)
TYPES="fix|feat|refactor|style|perf|docs|merge|resolve|chore|test"
STRUCTURED_PATTERN="^($TYPES)(\([a-zA-Z0-9_,-]+\))?: .{5,}"
if echo "$COMMIT_MSG" | head -1 | grep -qE "$STRUCTURED_PATTERN"; then
    # Already valid format — just warn if no ticket ref (don't block)
    if ! echo "$COMMIT_MSG" | grep -qiE "(Ref:|Ticket:|#[0-9]+|124744)"; then
        echo ""
        echo "  WARNING: No ticket reference found in commit message."
        echo "  Consider adding:  Ref: <ticket-id>"
        echo ""
    fi
    exit 0
fi

# ── LCA auto-enrich ──────────────────────────────

# Find project root
PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$PROJECT_ROOT" ]; then
    exit 0
fi

# Try LCA commit-msg command (auto-enriches the message file)
# Check if uv is available (preferred), else fall back to python
if command -v uv >/dev/null 2>&1; then
    LCA_CMD="uv run lca"
    LCA_DIR="$PROJECT_ROOT/logimax-devtools/backend/lca_core"
    if [ -d "$LCA_DIR" ]; then
        (cd "$LCA_DIR" && $LCA_CMD commit-msg "$PROJECT_ROOT" --msg-file "$COMMIT_MSG_FILE" --raw 2>/dev/null) || true
    fi
elif command -v python >/dev/null 2>&1; then
    # Direct Python fallback using standalone changeset.py
    CHANGESET_PY="$PROJECT_ROOT/logimax-devtools/backend/lca_core/changeset.py"
    CURRENT_JSON="$PROJECT_ROOT/.changes/current.json"
    if [ -f "$CHANGESET_PY" ] && [ -f "$CURRENT_JSON" ]; then
        GENERATED=$(python "$CHANGESET_PY" commit-msg 2>/dev/null)
        if [ -n "$GENERATED" ]; then
            ORIGINAL=$(head -1 "$COMMIT_MSG_FILE")
            if [ -n "$ORIGINAL" ]; then
                echo "$GENERATED" > "$COMMIT_MSG_FILE"
                echo "" >> "$COMMIT_MSG_FILE"
                echo "Original: $ORIGINAL" >> "$COMMIT_MSG_FILE"
            else
                echo "$GENERATED" > "$COMMIT_MSG_FILE"
            fi
        fi
    fi
fi

# Re-read the (possibly enriched) message for validation
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Validate the final message format
if ! echo "$COMMIT_MSG" | head -1 | grep -qE "$STRUCTURED_PATTERN"; then
    echo ""
    echo "  COMMIT REJECTED - Invalid commit message format"
    echo "  ─────────────────────────────────────────────────"
    echo ""
    echo "  Your message:  $(head -1 "$COMMIT_MSG_FILE")"
    echo ""
    echo "  Required format:"
    echo "    <type>(<module>): <description>"
    echo ""
    echo "  Allowed types:"
    echo "    fix      - Bug fix"
    echo "    feat     - New feature"
    echo "    refactor - Code restructure (no behavior change)"
    echo "    style    - CSS/UI only changes"
    echo "    perf     - Performance improvement"
    echo "    docs     - Documentation only"
    echo "    merge    - Merge-related commit"
    echo "    resolve  - Conflict resolution"
    echo "    chore    - Maintenance task"
    echo "    test     - Test-related changes"
    echo ""
    echo "  Tip: Create a changeset first for auto-generated messages:"
    echo "    python logimax-devtools/backend/lca_core/changeset.py add \\"
    echo "      --type fix --module billing --summary 'your summary'"
    echo ""
    exit 1
fi

# Warn if no ticket reference in body (but don't block)
if ! echo "$COMMIT_MSG" | grep -qiE "(Ref:|Ticket:|#[0-9]+|124744)"; then
    echo ""
    echo "  WARNING: No ticket reference found in commit message."
    echo "  Consider adding:  Ref: <ticket-id>"
    echo ""
fi

exit 0
