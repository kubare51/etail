# Environment Configuration
# Copy to .env and fill in values (gitignored)

# Target URL (no trailing slash)
BASE_URL=http://localhost/etail_v3/admin

# Login credentials
E2E_USERNAME=admin
E2E_PASSWORD=admin123

# Browser settings
HEADLESS=true
SLOW_MO=0
BROWSER=chromium

# Parallelism
WORKERS=1

# Database (for Tier 3 DB verification)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=retaillmx_admin
DB_PASSWORD=
DB_NAME=retail_dev

# Screenshots & video
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_FAILURE=true
