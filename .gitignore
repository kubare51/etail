.agent/skills/bug-fix-engine/roles/

# ============================================
# Logimax DevTools (regeneratable artifacts)
# ============================================

# Graphify AST cache and output (regeneratable)
graphify-out/

# Regeneratable LCA index database (92MB+)
logimax-devtools/backend/lca_index.db

# Large regeneratable index JSONs (multi-MB, rebuild with indexer)
logimax-devtools/backend/lca_core/admin_app_index.json
logimax-devtools/backend/lca_core/admin_js_index.json
logimax-devtools/backend/lca_core/master_index.json

# DevTools test files
logimax-devtools/backend/lca_core/test_*.py

# SQLite index databases (regeneratable)
logimax-devtools/backend/lca_core/*.db

# Generated report data (regeneratable)
logimax-devtools/docs/*_data*.json
logimax-devtools/docs/pipeline-state.json
logimax-devtools/backend/lca_core/impact_results.json

# --- RAG Pipeline (regeneratable via `rag ingest`) ---
logimax-devtools/backend/rag/chunks.jsonl
logimax-devtools/backend/rag/*.jsonl
logimax-devtools/backend/rag/logimax_rag.egg-info/
logimax-devtools/backend/rag/rag_store/
*.chroma
chroma.sqlite3

# --- Forge Training Pipeline (regeneratable via `forge collect`) ---
logimax-devtools/backend/forge/*.jsonl
logimax-devtools/backend/forge/training_data/
logimax-devtools/backend/forge/logimax_forge.egg-info/

# --- General Python build artifacts ---
logimax-devtools/backend/**/logimax_*.egg-info/
logimax-devtools/backend/**/*.egg-info/

# --- Node.js (devtools frontend/app) ---
logimax-devtools/app/node_modules/
logimax-devtools/frontend/node_modules/
logimax-devtools/app/dist/
logimax-devtools/frontend/dist/

# --- Python virtualenvs (devtools backend) ---
logimax-devtools/backend/.venv/
logimax-devtools/backend/lca_core/.venv/

# Local config overrides
global_configs.local.php
/.sdlc

/.agent
/.github
/.sdlc-v2
manepally_prod_28_06_26.sql
retailsource_20260723.sql

# Secrets (never commit)
.github_token
port_max/api/api_keys.local.php
