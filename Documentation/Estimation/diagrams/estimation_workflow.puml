@startuml Estimation_Workflow
!theme plain
title Estimation Module - End-to-End Workflow

|#LightBlue| Sales Staff |
|#LightGreen| Branch Manager |
|#LightYellow| System |

|Sales Staff|
start
:Open Add Estimation Form;

|System|
:Load Settings\n(rates, limits, permissions);
:Initialize Empty Estimation;

|Sales Staff|
:Select Customer;
if (Existing Customer?) then (yes)
    :Search and Select;
else (no)
    :Create New Customer;
endif

:Add Items;
repeat
    if (Item Type?) then (Tag)
        :Scan/Search Tag;
        |System|
        :Validate Tag Status\n(must be 1,3,4,6);
        :Load Tag Details\n(stones, charges, metals);
        :Calculate Item Cost;
    elseif (Catalog) then
        |Sales Staff|
        :Select Product/Design;
        :Enter Weight/Purity;
        |System|
        :Calculate Cost;
    else (Custom)
        |Sales Staff|
        :Enter Item Details;
        |System|
        :Calculate Cost;
    endif
    |Sales Staff|
    :Review Item Price;
repeat while (More Items?) is (yes)
->no;

if (Has Old Metal?) then (yes)
    :Enter Old Metal Details;
    |System|
    :Validate Rate Limits;
    :Calculate Purchase Credit;
endif

|Sales Staff|
:Apply Discounts;

|System|
if (Discount > Employee Limit?) then (yes)
    :Set is_eda = 1;
    :Save Estimation\n(is_eda_approved = 0);
    :Tags remain available;
    
    |Branch Manager|
    :View EDA Queue;
    :Review Estimation;
    if (Approved?) then (yes)
        :Set Final Amount;
        |System|
        :is_eda_approved = 1;
        :Update Tags → status 10;
        :Log Approval;
    else (no)
        |System|
        :is_eda_approved = 2;
        :Log Rejection;
        |Sales Staff|
        :Edit and Resubmit;
        stop
    endif
else (no)
    :Set is_eda = 0;
    :Save Estimation;
    :Update Tags → status 9;
endif

|Sales Staff|
:Print Invoice;
:Convert to Bill;

|System|
:Create Billing Record;
:Link estbillid;

stop

@enduml
